# Python byte code and virtual environments
__pycache__/
*.py[cod]
*$py.class
*.so
.env
venv/
.venv/
env/

# Tests and test scripts (USER SPECIFIED: NEVER PUSH TESTS)
tests/
test*.py

# Automation, browser, and temporary logs
.playwright-mcp/
gcm_out.txt
test_write.py
test.txt
auth_url.txt
*.log

# Sensitive Google OAuth credentials & tokens (CRITICAL SECURITY)
data/credentials/*
!data/credentials/.gitkeep
client_secret*.json
token*.json
token.json

# Local user runtime data, video queues, history, and settings
data/*.json
data/uploads/*
!data/uploads/.gitkeep
data/generated/*
!data/generated/.gitkeep
data/thumbnails/*
!data/thumbnails/.gitkeep
watch_folder/*
!watch_folder/.gitkeep

# Media files that might be accidentally placed in workspace root
*.mp4
*.mov
*.mp3
*.wav
*.srt
